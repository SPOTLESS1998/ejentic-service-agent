# ─────────────────────────────────────────────────────────────
# Ejentic Service Agent — environment template
# Copy to `.env` and fill in. NEVER commit the real .env.
# The service runs even with NO keys set (offline mock provider),
# so you can demo the full flow before wiring real providers.
# ─────────────────────────────────────────────────────────────

# Which tenant config to load from /tenants (folder name).
TENANT=ejentic

# HTTP port for the agent service.
PORT=4000

# Comma-separated origins allowed to call the API / embed the widget.
# Use * only for local demos.
ALLOWED_ORIGINS=*

# ── AI Providers (all optional — router falls back down this list,
#    then to an offline mock if none are configured) ──
# Tier 1: Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Tier 2: FreeLLMAPI gateway (OpenAI-compatible; auto-routes free providers)
FREELLMAPI_KEY=
FREELLMAPI_BASE_URL=http://localhost:3001/v1

# Tier 3: NVIDIA (OpenAI-compatible, single-provider last resort)
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# ── Embeddings for RAG retrieval (optional) ──
# If set, uses this OpenAI-compatible endpoint for embeddings.
# If empty, the engine uses a built-in deterministic local embedder
# (keyword hashing) so retrieval still works fully offline.
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=https://api.openai.com/v1
EMBEDDINGS_MODEL=text-embedding-3-small

# ── Human escalation email (SMTP) ──
# If unset, escalations are still captured + logged; email is skipped.
SMTP_USER=
SMTP_PASS=
# Where "I don't know / talk to a human" notifications are sent.
# Defaults to SMTP_USER if empty.
ESCALATION_INBOX=

# ── Security ──
# Rate limit: max requests per IP per window.
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000
# Optional shared secret for admin endpoints (feedback export, reindex).
ADMIN_TOKEN=
